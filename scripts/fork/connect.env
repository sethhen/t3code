# T3 Connect public build config for fork builds (account sign-in + mobile link).
#
# These are PUBLIC values, copied from the official T3 Code 0.0.42 app bundle
# (they ship inside every copy of T3 Code; official builds get them from T3's
# repo variables at build time). Refresh them if T3 rotates its Clerk instance
# or moves the relay: extract the VITE_* values from a new official build.
#
# Consumed by scripts/lib/public-config.ts (loadRepoEnv), which mirrors each
# T3CODE_* name into the VITE_* name the web client bakes in (see
# apps/web/vite.config.ts). Plain KEY=value lines only: CI appends them to
# $GITHUB_ENV (.github/workflows/fork-release.yml) and local builds can
# `set -a; source scripts/fork/connect.env; set +a`.
T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
T3CODE_CLERK_JWT_TEMPLATE=t3-relay
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r
T3CODE_RELAY_URL=https://relay.t3.codes
